# ---- Required ---------------------------------------------------------------------------------------
# Apify Console -> Settings -> API & Integrations -> Personal API token
APIFY_TOKEN=
# openrouter.ai -> Keys. Buy $10 of credits once: it raises the free-model limit to 1,000 requests/day.
OPENROUTER_API_KEY=

# ---- Notifications (optional, but you want at least one) --------------------------------------------
# Telegram: create a bot with @BotFather, send it any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail via any SMTP server (e.g. Gmail with an app password: smtp.gmail.com, port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=

# ---- Money guards (defaults shown) -------------------------------------------------------------------
# Hard monthly cap for paid LLM calls. Free models are always tried first.
REEF_LLM_MONTHLY_BUDGET_USD=15
# Stop building new Actors when Apify platform usage this month reaches this amount.
REEF_APIFY_MONTHLY_CAP_USD=25
# Price you charge users.
REEF_PRICE_PER_1000_RESULTS=2.0

# ---- Fleet behaviour (defaults shown) ----------------------------------------------------------------
REEF_MAX_NEW_ACTORS_PER_WEEK=5
REEF_MAX_LIVE_ACTORS=60
REEF_MIN_AGE_DAYS_BEFORE_PRUNE=60
REEF_CLONE_THRESHOLD_USERS30=10
REEF_RETIRE_AFTER_MAINTENANCE_DAYS=14
REEF_HEAL_INTERVAL_HOURS=6

# ---- Models (defaults: picked automatically from OpenRouter's live catalogue) ------------------------
# Comma-separated list of free models to try in order, or "auto".
REEF_FREE_MODELS=auto
# Paid fallback model id, "auto", or empty to never use a paid model.
REEF_PAID_MODEL=auto
# "auto" only picks paid models whose output price is at most this many USD per million tokens.
REEF_MAX_PAID_PRICE_PER_MTOK=3

# Extra domains Reef must never touch (comma-separated).
REEF_EXTRA_BLOCKED_DOMAINS=
